{
  "name": "Chess Assist",
  "short_name": "Chess Assist",
  "manifest_version": 3,
  "version": "1.2",
  "description": "Chess Assist",
  "author": "Tristrum Tuttle",
  "icons": {
    "16": "/img/chess_assist50.png",
    "48": "/img/chess_assist50.png",
    "128": "/img/chess_assist50.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "all_frames": true,
      "js": ["src/Tier.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "permissions": ["storage"]
}
